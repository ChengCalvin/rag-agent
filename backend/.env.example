# Copy to backend/.env (git-ignored). Names only; never commit values.
# ADK finds backend/.env by walking up from backend/src/novamart_agent/ (design D6).

# AI Studio free key (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Force the AI Studio backend so an ambient Vertex flag in the shell cannot route to Vertex.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Legacy name for the same switch (older ADK / google-genai versions).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional overrides (defaults live in config.py; model IDs are provisional until task 1.2 is owner-run).
# NOVAMART_MODEL=
# NOVAMART_EMBEDDING_MODEL=
# NOVAMART_PRICE_TABLE=   # JSON, see README; every price is VERIFY until checked on the published pricing page
# NOVAMART_SHOW_COST=true
# NOVAMART_USER=          # persona selector
# NOVAMART_SIMILARITY_THRESHOLD=0.6   # retrieval gate, 0 to 1; tuned on the eval set
# NOVAMART_TOP_K=3                    # chunks returned per search
# NOVAMART_MAX_QUERY_CHARS=500        # longest search query embedded; longer gets no_answer

# Free-tier test runs: separate quota from the default model
# NOVAMART_MODEL=gemini-3.1-flash-lite